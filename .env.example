# ── Touchpoint Center — backend env ──
# See PLAN.md §9 (deployment) and §15 (cost-optimized provider defaults).

# This API's own public origin — providers (Vapi, Telnyx, myKaarma) call back here.
APP_URL=http://localhost:3000
# The Next.js dashboard origin — anything a person clicks (invites, unsubscribe, booking links).
WEB_URL=http://localhost:3001

# ── Supabase (separate NEW project; own DB/Auth/Storage) ──
# IMPORTANT: DATABASE_URL must be the SESSION-mode pooler (port 5432), NOT transaction-mode
# PgBouncer — pg-boss uses LISTEN/NOTIFY + long-lived connections that break silently otherwise.
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Anthropic (BYO key — also passed into Vapi to skip its LLM markup, §15) ──
ANTHROPIC_API_KEY=
# Live voice loop uses Haiku (cheap + low latency); offline jobs use Sonnet.
LLM_MODEL_CALL=claude-haiku-4-5-20251001
LLM_MODEL_OFFLINE=claude-sonnet-4-6

# ── Voyage (embeddings for RAG ingest) ──
VOYAGE_API_KEY=

# ── Telnyx (telephony: voice numbers + SMS — §15). Start 10DLC registration ASAP (1–4wk). ──
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# ── Vapi (voice orchestrator) ──
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# TTS: A/B Cartesia / Deepgram Aura-2 vs ElevenLabs during staff week (§15). Native Vapi options.
DEFAULT_TTS_PROVIDER=cartesia
DEFAULT_VOICE_ID=
ELEVENLABS_API_KEY=

# ── Resend (email) ──
RESEND_API_KEY=
EMAIL_FROM=

# ── myKaarma (booking — later; runs in `soft` mode until this exists, §2) ──
MYKAARMA_API_KEY=
MYKAARMA_DEALER_ID=

# ── Defaults / branding ──
DEFAULT_TIMEZONE=America/Los_Angeles
