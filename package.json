{
  "name": "actumauto",
  "version": "0.1.0",
  "type": "module",
  "description": "AI service-reminder platform for auto-dealership service departments",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx scripts/preflight.ts",
    "dev:all": "npm run dev & (cd web && npm run dev) & wait",
    "stop": "pkill -f 'tsx watch src/index.ts' ; pkill -f 'next dev' ; true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.47.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "luxon": "^3.5.0",
    "papaparse": "^5.4.1",
    "pg-boss": "^10.1.5",
    "resend": "^4.0.1",
    "tsx": "^4.19.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
