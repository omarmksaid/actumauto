# ── Touchpoint Center — backend env (INBOUND-ONLY) ──
# Copy to .env and fill in. Run `npm run preflight` to verify before wiring up Vapi.

# ════════════ REQUIRED — the app will not boot without these ════════════

# This API's public origin. Vapi calls back here, so in local dev this must be your
# ngrok/tunnel URL (NOT localhost) once you start taking real calls.
APP_URL=http://localhost:3000
# The dashboard origin (unsubscribe links point here).
WEB_URL=http://localhost:3001

# ── Supabase ──
# DATABASE_URL must be the SESSION-mode pooler (port 5432), NOT transaction mode (6543):
# pg-boss uses LISTEN/NOTIFY + long-lived connections that break *silently* otherwise.
# Supabase dashboard → Project Settings → Database → Connection string → Session pooler.
DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Project Settings → Data API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Settings → JWT Secret (NOT the anon key)
SUPABASE_JWT_SECRET=

# ── Anthropic — the agent's reasoning. Passed into Vapi as a BYO key. ──
ANTHROPIC_API_KEY=

# ── Vapi — voice orchestration ──
# VAPI_WEBHOOK_SECRET is any strong random string you invent; you paste the SAME value into
# Vapi's server config. Every inbound request is rejected without it, so it is required.
#   generate one:  openssl rand -hex 32
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# ════════════ OPTIONAL — sensible defaults, override only if needed ════════════

# Live voice loop uses Haiku (cheap + low latency).
LLM_MODEL_CALL=claude-haiku-4-5-20251001
LLM_MODEL_OFFLINE=claude-sonnet-4-6

# TTS (native Vapi providers — config, not integrations). Leave DEFAULT_VOICE_ID blank to use
# the provider's default, or set a specific voice id.
DEFAULT_TTS_PROVIDER=cartesia
DEFAULT_VOICE_ID=
ELEVENLABS_API_KEY=

DEFAULT_TIMEZONE=America/Los_Angeles

# ── Telnyx — only needed to BUY the number callers dial. The app never calls the Telnyx API
#    (no SMS, no outbound), so this can stay blank if you buy the number in the dashboard. ──
TELNYX_API_KEY=

# ── Resend — transactional email. Nothing calls it yet; safe to leave blank. ──
RESEND_API_KEY=
EMAIL_FROM=

# ── myKaarma — not available yet; booking runs in `soft` mode until it is. ──
MYKAARMA_API_KEY=
MYKAARMA_DEALER_ID=
